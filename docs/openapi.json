  "components": {
    "schemas": {
      "CalibrationCreate": {
        "properties": {
          "exercise": {
            "type": "string",
            "enum": [
              "squat",
              "pushup",
              "plank",
              "pullup"
            ],
            "title": "Exercise",
            "default": "squat"
          },
          "participant_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Participant Id",
            "default": "local-user"
          },
          "variation": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Variation"
          },
          "view": {
            "type": "string",
            "const": "side",
            "title": "View",
            "default": "side"
          },
          "record_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 3,
            "title": "Record Ids"
          }
        },
        "type": "object",
        "required": [
          "variation",
          "record_ids"
        ],
        "title": "CalibrationCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LabelUpdate": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "good",
                  "depth",
                  "torso_lean",
                  "body_alignment",
                  "torso_swing",
                  "unusable",
                  "unobservable"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "participant_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Participant Id"
          }
        },
        "type": "object",
        "title": "LabelUpdate"
      },
      "SessionCreate": {
        "properties": {
          "exercise": {
            "type": "string",
            "enum": [
              "squat",
              "pushup",
              "plank",
              "pullup"
            ],
            "title": "Exercise",
            "default": "squat"
          },
          "participant_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Participant Id",
            "default": "local-user"
          },
          "variation": {
            "type": "string",
            "maxLength": 80,
            "title": "Variation",
            "default": ""
          },
          "view": {
            "type": "string",
            "const": "side",
            "title": "View",
            "default": "side"
          }
        },
        "type": "object",
        "title": "SessionCreate"
      },
      "TrainingCreate": {
        "properties": {
          "exercise": {
            "type": "string",
            "enum": [
              "squat",
              "pushup",
              "pullup"
            ],
            "title": "Exercise"
          },
          "model": {
            "type": "string",
            "enum": [
              "baseline",
              "cnn",
              "gru"
            ],
            "title": "Model",
            "default": "baseline"
          },
          "feature_set": {
            "type": "string",
            "enum": [
              "full",
              "angles",
              "keypoints"
            ],
            "title": "Feature Set",
            "default": "full"
          },
          "epochs": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Epochs",
            "default": 40
          },
          "augment": {
            "type": "boolean",
            "title": "Augment",
            "default": false
          },
          "export_onnx": {
            "type": "boolean",
            "title": "Export Onnx",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "exercise"
        ],
        "title": "TrainingCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
